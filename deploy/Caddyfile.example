# Add this site block to /var/www/Caddyfile, then reload Caddy:
#   docker exec hsewebserver caddy reload --config /etc/caddy/Caddyfile
#
# The app's web container (setupcertificationhseboard) joins the shared
# hse-app-network, so Caddy reaches it by container name — same pattern
# as credentials.hseboard.com.

setup.certification.hseboard.com {

    reverse_proxy setupcertificationhseboard:80 {
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote}
    }

    log {
        output file /var/log/caddy/setupcertificationhseboard.log
        format console
    }
}
