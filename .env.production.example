# Production environment for setup.certification.hseboard.com
# Copy to .env on the server and fill in every CHANGE_ME.

APP_NAME="HSE Credential"
APP_ENV=production
APP_DEBUG=false
# Generate and store with:
#   KEY=$(docker compose -f docker-compose.prod.yml run --rm --entrypoint php app artisan key:generate --show)
#   sed -i "s|^APP_KEY=.*|APP_KEY=$KEY|" .env
APP_KEY=CHANGE_ME
APP_URL=https://setup.certification.hseboard.com

SANCTUM_STATEFUL_DOMAINS=setup.certification.hseboard.com
SESSION_SECURE_COOKIE=true

# stderr sends app logs to `docker logs setupcertificationhseboard`,
# like the other hseboard containers.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite on the shared storage volume — path is set by docker-compose.prod.yml.
# Nothing to configure here; back up storage/app/database/database.sqlite.
DB_CONNECTION=sqlite

# Real SMTP — certificate delivery, invites, newsletters.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=credentials@hseboard.com
MAIL_FROM_NAME="HSE Credential"
