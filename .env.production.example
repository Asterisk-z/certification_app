# Production environment for setup.certification.hseboard.com
# Copy to .env on the server and fill in every CHANGE_ME.

APP_NAME="HSE Credential"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_URL=https://setup.certification.hseboard.com

SANCTUM_STATEFUL_DOMAINS=setup.certification.hseboard.com
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=hse_credential
DB_USERNAME=hse
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Real SMTP — certificate delivery, invites, newsletters.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=credentials@hseboard.com
MAIL_FROM_NAME="HSE Credential"
